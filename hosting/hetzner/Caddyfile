# HTTPS-Zertifikate holt Caddy automatisch (Let's Encrypt).
# Voraussetzung: die DNS-Einträge zeigen direkt auf diesen Server
# (in Cloudflare „DNS only“, graue Wolke).
{
	email {$ACME_EMAIL}

	# Die Abfrage gehört nicht ins Protokoll. Zugriffsprotokolle führt Caddy hier
	# keine, aber der Fehler-Logger (http.log.error) schreibt die volle Adresse mit –
	# und der schlägt bei jedem Deploy an: Während die API neu startet, laufen die
	# Anfragen ins Leere, und eine Suche in genau diesem Moment stünde dort im
	# Klartext. Der Server kürzt seit e13c2d4 genauso; das hier ist dieselbe Regel
	# eine Ebene davor, denn Caddy protokolliert unabhängig vom Server.
	#
	# Gekürzt wird nur ab dem Fragezeichen: Pfad, Methode, Adresse, Port und Status
	# bleiben, sonst wäre die Zeile für die Fehlersuche wertlos – und genau dafür
	# ist sie da. Authorization schwärzt Caddy von sich aus.
	log {
		format filter {
			wrap json
			fields {
				request>uri regexp "\?.*$" ""
				# Der Referer ist der zweite Weg, auf dem eine Abfrage in dieselbe
				# Zeile gerät: Kommt jemand von /beta?code=... oder /login?next=...,
				# steht das dort. Suchbegriffe sind davon nicht betroffen, aber
				# Einladungscodes schon – und eine Zeile kostet es nicht mehr.
				request>headers>Referer regexp "\?.*$" ""
			}
		}
	}
}

# ACHTUNG, falls hier je Zugriffsprotokolle dazukommen: Ein "log" INNERHALB eines
# Site-Blocks legt einen eigenen Logger an, und der erbt den Filter oben NICHT.
# Caddy schreibt dort wieder die volle Adresse samt Abfrage. Wer Zugriffsprotokolle
# will, muss denselben format-filter-Block im Site-Block wiederholen.

xyntal.de, www.xyntal.de {
	encode zstd gzip
	reverse_proxy website:4129
}

# Admin-Bereich: in Cloudflare „Proxied“ (orange Wolke) mit Cloudflare Access davor,
# SSL-Modus „Strict“ (Configuration Rule nur für diesen Host). Das erste Zertifikat holt Caddy, während
# der DNS-Eintrag kurz auf „DNS only“ steht; Verlängerungen laufen danach auch über den Proxy.
# Die Website prüft zusätzlich das Access-Token (hosting/daki/server.cjs), direkte Aufrufe der IP bekommen 403.
admin.xyntal.de {
	encode zstd gzip
	reverse_proxy website:4129
}

api.xyntal.de {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000"
	}
	# Long-Polling und Uploads sofort durchreichen, nichts puffern.
	reverse_proxy api:8787 {
		flush_interval -1
	}
}

# Web-Panel von Xyntal Guard (Discord-Bot). Läuft nur mit COMPOSE_PROFILES=discord;
# sonst antwortet diese Adresse mit 502. DNS: A-Record "bot", „DNS only“.
bot.xyntal.de {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy discord-guard:8790
}
